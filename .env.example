# Configuración de Base de Datos
# ==============================
# La aplicación soporta PostgreSQL mediante esta variable. 
# Descomentar para usar en Docker/Producción:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/tareas_db

# FALLBACK LOCAL:
# Para desarrollo local rápido, si DATABASE_URL no está definida, 
# la aplicación usará por defecto una base de datos local: sqlite:///./tareas.db
DB_PASSWORD=super-secreto-local